APP_ENV=development
DRY_RUN=true
LOG_LEVEL=INFO

# PostgreSQL
# Exemplo: postgresql://usuario:senha@host:5432/banco?sslmode=require
POSTGRES_URL=

# MongoDB
MONGODB_URI=
MONGODB_DATABASE=
MONGODB_SESSIONS_COLLECTION=sessoes

# Qdrant
QDRANT_URL=
QDRANT_API_KEY=
QDRANT_SUMMARIES_COLLECTION=memoria_resumos

# Firebase
FIREBASE_PROJECT_ID=
# JSON completo da conta de serviço do Firebase Admin SDK codificado em Base64
FIREBASE_CREDENTIALS_BASE64=
